# Copy to .env.local. All values are optional.

# Devin API (v3). Without these the investigator runs the deterministic fallback and the UI says so.
# Service user key or personal access token, prefix "cog_".
DEVIN_API_KEY=
# Organisation id, prefix "org-".
DEVIN_ORG_ID=

# Public base URL of this app, reachable from the Devin session machine (tunnel or deployed host).
# Devin calls the investigation tool endpoints on it.
GLD_PUBLIC_URL=

# Set to 1 to force the deterministic fallback even when Devin is configured.
GLD_FORCE_FALLBACK=

# Pause between tool calls in the deterministic fallback, in milliseconds.
GLD_STEP_DELAY_MS=600
