# Copy to .env.local. All values are optional.
# Devin runs only when DEVIN_API_KEY, DEVIN_ORG_ID and GLD_PUBLIC_URL are all set
# and GLD_FORCE_FALLBACK is not 1. Otherwise the deterministic fallback runs and the UI says why.

# Devin API v3 key (service user key or personal access token, prefix "cog_").
DEVIN_API_KEY=
# Devin organization id, prefix "org-".
DEVIN_ORG_ID=
# Devin API base URL. Leave empty for https://api.devin.ai.
DEVIN_API_BASE_URL=

# Public base URL of this app (tunnel or deployed host), reachable from the Devin machine. Devin calls the tool endpoints on it.
GLD_PUBLIC_URL=
# Set to 1 to also serve the dashboard and simulator routes on GLD_PUBLIC_URL. By default only the tool endpoints are public there.
GLD_PUBLIC_DASHBOARD=

# Devin mode, for example fast or normal. Empty means the organization default.
GLD_DEVIN_MODE=
# Maximum ACUs (Agent Compute Units) one investigation session may spend. Empty means no limit.
GLD_DEVIN_MAX_ACU=
# Time cap on the whole Devin phase in milliseconds. After it the deterministic fallback takes over.
GLD_DEVIN_TIMEOUT_MS=240000
# How often the backend polls the Devin session, in milliseconds. Devin docs discourage less than 10000.
GLD_DEVIN_POLL_MS=10000

# Set to 1 to force the deterministic fallback even when Devin is configured.
GLD_FORCE_FALLBACK=

# Pause between tool calls in the deterministic fallback, in milliseconds.
GLD_STEP_DELAY_MS=600
