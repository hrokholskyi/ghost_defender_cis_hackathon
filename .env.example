# Copy to .env.local. All values are optional.

# Without a key the investigator runs the deterministic fallback and the UI says so.
ANTHROPIC_API_KEY=

# Claude model for the investigation agent.
GLD_MODEL=claude-sonnet-5-5

# Set to 1 to force the deterministic fallback even when a key is present.
GLD_FORCE_FALLBACK=

# Pause between tool calls in the deterministic fallback, in milliseconds.
GLD_STEP_DELAY_MS=600
